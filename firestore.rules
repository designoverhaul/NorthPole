rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth token phone is E.164 (+12055551234).
    // App always stores canonical digits with country code (12055551234).
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.phone_number is string;
    }

    function isOwnerPhone(storedPhone) {
      return isSignedIn()
        && storedPhone is string
        && storedPhone.size() > 0
        && request.auth.token.phone_number == '+' + storedPhone;
    }

    match /users/{phone} {
      allow read: if isSignedIn();
      allow write: if isOwnerPhone(phone);
    }

    // Friends need authenticated reads to load wishlists by ownerPhone.
    // Writes are owner-only except friends may flip isPurchased when claiming.
    match /wishlistItems/{itemId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isOwnerPhone(request.resource.data.ownerPhone);

      allow update: if isSignedIn() && (
        isOwnerPhone(resource.data.ownerPhone)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPurchased'])
          && request.resource.data.ownerPhone == resource.data.ownerPhone
          && request.resource.data.name == resource.data.name
        )
      );

      allow delete: if isOwnerPhone(resource.data.ownerPhone);
    }

    match /children/{childId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isOwnerPhone(request.resource.data.parentPhone);
      allow update, delete: if isOwnerPhone(resource.data.parentPhone);
    }

    // purchaserPhone stays private — only owner or purchaser can read.
    // Friends use wishlistItems.isPurchased for claim status.
    match /purchases/{purchaseId} {
      // resource is null when the document does not exist; without this the
      // rule throws and the client sees "permission denied" instead of "not found".
      allow read: if isSignedIn() && (
        resource == null
        || isOwnerPhone(resource.data.ownerPhone)
        || isOwnerPhone(resource.data.purchaserPhone)
      );

      allow create: if isSignedIn()
        && isOwnerPhone(request.resource.data.purchaserPhone)
        && request.resource.data.isActive == true;

      allow update, delete: if isSignedIn() && (
        isOwnerPhone(resource.data.purchaserPhone)
        || isOwnerPhone(resource.data.ownerPhone)
      );
    }

    match /friends/{friendshipId} {
      // resource is null when the document does not exist — adding a new friend
      // reads the doc first to decide create vs merge.
      allow read: if isSignedIn() && (
        resource == null
        || isOwnerPhone(resource.data.userPhone)
        || isOwnerPhone(resource.data.friendPhone)
      );

      allow create: if isSignedIn()
        && isOwnerPhone(request.resource.data.userPhone);

      allow update, delete: if isOwnerPhone(resource.data.userPhone);
    }
  }
}
