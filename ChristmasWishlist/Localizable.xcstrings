    "Add children who don't have their own phone so you can manage their wishlists. When friends add you, they'll see your children too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Kinder ohne eigenes Handy hinzu, damit du ihre Wunschlisten verwalten kannst. Wenn Freunde dich hinzufügen, sehen sie auch deine Kinder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade niños que no tienen teléfono propio para gestionar sus listas. Cuando tus amigos te añadan, también verán a tus hijos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les enfants qui n’ont pas de téléphone pour gérer leurs listes. Lorsque vos amis vous ajoutent, ils voient aussi vos enfants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi i bambini che non hanno un telefono per gestire le loro liste. Quando gli amici ti aggiungono, vedranno anche i tuoi bambini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のスマホを持たない子どもを追加すると、そのウィッシュリストを管理できます。友だちがあなたを追加すると、子どものリストも表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione crianças que não têm celular para gerenciar as listas delas. Quando seus amigos adicionarem você, verão suas crianças também."
          }
        }
      }
    },
