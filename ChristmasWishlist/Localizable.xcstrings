    "Are you sure you want to delete %@? This will also delete all their wishlist items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du %@ wirklich löschen? Dabei werden auch alle Wünsche gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres eliminar a %@? También se eliminarán todos sus artículos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer %@ ? Tous ses articles seront également supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi davvero eliminare %@? Verranno eliminati anche tutti i suoi articoli."
          }
        },
        "ja" : {
