    "This will permanently delete your wishlists, children, purchases, friends, and account from North Pole. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden deine Wunschlisten, Kinder, Käufe, Freunde und dein Account endgültig aus North Pole gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará de forma permanente tus listas, niños, compras, amigos y tu cuenta de North Pole. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement vos listes, enfants, achats, amis et votre compte de North Pole. Elle est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione eliminerà definitivamente le tue liste, i bambini, gli acquisti, gli amici e il tuo account da North Pole. Non è reversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "North Pole からウィッシュリスト、子ども、購入履歴、友だち、アカウントが完全に削除されます。この操作は取り消せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente suas listas, crianças, compras, amigos e sua conta do North Pole. Não é possível desfazer."
          }
        }
      }
    },
