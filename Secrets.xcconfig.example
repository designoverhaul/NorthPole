// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and add your actual API key
// Secrets.xcconfig is gitignored and will not be committed

XAI_API_KEY = YOUR_XAI_API_KEY_HERE

// Superwall public API key, from Superwall dashboard -> Settings -> Keys
SUPERWALL_API_KEY = YOUR_SUPERWALL_PUBLIC_API_KEY_HERE




